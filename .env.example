# Healthcare Appointment & Follow-up Manager
# Copy to backend/.env (and set NEXT_PUBLIC_API_URL in web/.env.local).
# Populated incrementally as each chunk lands — Chunk 1 only needs
# FLASK_ENV / SECRET_KEY / CORS_ORIGINS / NEXT_PUBLIC_API_URL to run.

# --- Flask (Chunk 1) ---
FLASK_ENV=development
SECRET_KEY=change-me-in-production
CORS_ORIGINS=http://localhost:3000

# --- Database (Chunk 2) ---
DATABASE_URL=postgresql://user:password@localhost:5432/healthcare_appt

# --- Redis (Chunks 8, 12+) — locks, cache, Celery broker/backend ---
REDIS_URL=redis://localhost:6379/0

# --- Auth (Chunk 3) ---
JWT_SECRET=change-me-in-production
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRES_DAYS=7

# --- Claude API — LLM pre/post-visit summaries (Chunks 12-13) ---
ANTHROPIC_API_KEY=

# --- SendGrid — email notifications (Chunk 14) ---
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=notifications@example.com

# --- Google Calendar OAuth 2.0 (Chunk 15) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5000/api/v1/calendar/oauth/callback

# --- Web app (Next.js) ---
# Points the frontend at the deployed/local API base URL.
NEXT_PUBLIC_API_URL=http://localhost:5000
